# A short sample story. Replace it with yours: every .kulisa file in the game is loaded,
# and the story starts at `label start`.

define mila = Character("Mila", { color = "#e8a0bf" })
define ren = Character("Ren", { color = "#7fb8d8" })
default tea = false

label start:
    scene bg room with fade
    "The light in the window had gone from gold to violet."
    show mila neutral at left with dissolve
    mila "You found the place. Most people walk right past the door."
    show ren neutral at right with dissolve
    ren "I almost did. The sign is {i}very{/i} small."
    show mila happy
    mila "That's the point. Tea?"
    menu:
        mila "Tea?"
        "Yes, please.":
            $ tea = true
            show ren happy
            ren "I'd love some."
        "Maybe later.":
            ren "Maybe later. I want to look around first."
    jump evening

label evening:
    scene bg night with swirl
    "Later, the street outside went quiet."
    show mila neutral at center
    with wiperight
    if tea:
        mila "Thanks for staying. The tea was better with company."
    else:
        mila "You never did have that tea."
    mila "Come back tomorrow? I'll tell you why the sign is so small."
    hide mila with dissolve
    "{w=0.3}The end. {size=0.8}Try the quick menu: Back, History, Skip and Auto.{/size}"
    return
