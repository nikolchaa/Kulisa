# A short sample story. Replace it with yours: every .kulisa file in the game is loaded,
# and the story starts at `label start`.

define kitty = Character("Kitty", { color = "#f6c1c7" })
define fluffy = Character("Fluffy", { color = "#c9a98a" })
default snack = false

label start:
    scene bg kitchen with fade
    "Afternoon sun had found the kitchen counter, and someone small had found the sun."
    show kitty neutral at left with dissolve
    kitty "Mrrp? You're new here. Are you here about the counter too?"
    show fluffy left at midright with dissolve
    fluffy "Nobody is here about the counter. The counter is {i}off limits{/i}."
    show kitty happy
    kitty "Which is exactly why the treats live up there. Want one?"
    menu:
        kitty "Want one?"
        "Yes, please.":
            $ snack = true
            fluffy "...Fine. One crunchy each. Don't tell the humans."
        "Maybe later.":
            show fluffy right
            fluffy "Later, then. I'll be in my sunbeam."
    jump playroom

label playroom:
    scene bg playroom with swirl
    "By evening the whole gang had gathered in the playroom."
    show kitty neutral at center
    with wiperight
    if snack:
        kitty "Thanks for sharing. Treats taste better with company."
    else:
        kitty "You never did get that treat."
    kitty "Come back tomorrow? I'll show you the tunnel."
    hide kitty with dissolve
    "{w=0.3}The end. {size=0.8}Try the quick menu: Back, History, Skip and Auto.{/size}"
    return
